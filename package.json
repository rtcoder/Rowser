{
  "name": "rowser",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --config extension/chrome/vite.config.ts --host 127.0.0.1",
    "dev:chrome": "vite --config extension/chrome/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config extension/chrome/vite.config.ts",
    "build:chrome": "tsc --noEmit && vite build --config extension/chrome/vite.config.ts",
    "build:firefox": "tsc --noEmit && vite build --config extension/firefox/vite.config.ts",
    "package:chrome": "sh scripts/package-extension.sh chrome",
    "package:firefox": "sh scripts/package-extension.sh firefox",
    "verify:no-remote-code": "sh scripts/verify-no-remote-code.sh chrome",
    "verify:no-remote-code:firefox": "sh scripts/verify-no-remote-code.sh firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.0",
    "web-ext": "^10.6.0"
  }
}
